#!/bin/sh
# pk's OS boot hook :: dynamic driver management (plug & play) busybox mdev se
#   boot option: pk_mdev=off  se band (default: on)
#
# Hamare live image me udev/systemd nahi hai; isliye kernel ke hotplug hook par
# busybox ka mdev lagate hain: USB/Thunderbolt/PCI device aate hi uska modalias
# modprobe hota hai (nic, wifi dongle, storage, input) aur /dev ke nodes bante hain.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
[ -e /proc/sys/kernel/hotplug ] || exit 0
for a in $(cat /proc/cmdline 2>/dev/null); do
  case "$a" in pk_mdev=off|nomdev) echo "pk-boot: mdev off (pk_mdev=off)"; exit 0 ;; esac
done
[ -e /bin/mdev ] || { echo "pk-boot: /bin/mdev nahi (busybox mdev applet) - hotplug hook skip"; exit 0; }
busybox mdev -s 2>/dev/null || true
mkdir -p /etc/mdev 2>/dev/null

cat > /etc/mdev/hotplug.sh <<'HOOK'
#!/bin/sh
# $1 action (add/remove), $MODALIAS / $DEVTYPE / $INTERFACE mdev se
case "$ACTION" in
  add|"")
    [ -n "${MODALIAS:-}" ] && modprobe -q "$MODALIAS" 2>/dev/null
    # net device aaya aur DHCP configured hai to ek baar try (idempotent)
    if [ -n "${INTERFACE:-}" ] && grep -q '^PK_DHCP=yes' /etc/default/pk 2>/dev/null; then
      command -v pk-net >/dev/null 2>&1 && pk-net dhcp >/dev/null 2>&1 || true
    fi
    ;;
  remove) : ;;
esac
exit 0
HOOK
chmod 755 /etc/mdev/hotplug.sh

if [ ! -f /etc/mdev.conf ]; then
  cat > /etc/mdev.conf <<'CONF'
# busybox mdev config - /dev ke nodes (mode 666 jo char/block hon)
console		0:5	600
fb0		0:44	660
input/.*	0:0	600
tty[0-9]*	0:5	666
.*		0:0	666	@/etc/mdev/hotplug.sh
CONF
fi
printf '/bin/mdev\n' > /proc/sys/kernel/hotplug 2>/dev/null && hp=/bin/mdev || hp=$(cat /proc/sys/kernel/hotplug 2>/dev/null)
printf '### PK: MDEV-OK (hotplug=%s) ###\n' "${hp:-?}" > /dev/console 2>/dev/null
echo "pk-boot: mdev ready (hotplug=${hp:-?})"
exit 0
