#!/bin/sh
# pk's OS boot hook :: dynamic device/node + driver management (busybox mdev)
#   default: ON   (band karna ho to boot option: pk_mdev=off  ya  nomdev)
#
# Modern kernels (>=6.5) me purana /proc/sys/kernel/hotplug helper interface par
# bharosa nahi; isliye yahan netlink listener (`uevent mdev`) + coldplug (`mdev -s`)
# chalate hain. Har uevent par /etc/mdev/hotplug.sh chalta hai -> modprobe $MODALIAS
# (USB wifi/ethernet/storage aate hi driver) aur NIC aaye to (PK_DHCP=yes ho) DHCP bhi.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
say()  { printf 'pk-boot(mdev): %s\n' "$*"; }
mark() { ( printf '### PK: %s ###\n' "$*" > /dev/console ) 2>/dev/null; ( printf '%s\n' "$*" > /dev/kmsg ) 2>/dev/null; }
have() { command -v "$1" >/dev/null 2>&1; }

for a in $(cat /proc/cmdline 2>/dev/null); do
  case "$a" in pk_mdev=off|nomdev) say "band (pk_mdev=off)"; exit 0 ;; esac
done

if [ ! -x /bin/mdev ] && ! have mdev; then
  say "busybox mdev applet nahi mila - hook skip"
  mark "MDEV-SKIP (no mdev applet)"
  exit 0
fi

mkdir -p /etc/mdev 2>/dev/null
cat > /etc/mdev/hotplug.sh <<'HOOK'
#!/bin/sh
# /etc/mdev.conf ke @action se chalta hai; vars mdev set karta hai
case "${ACTION:-add}" in
  add|remove)
    [ -n "${MODALIAS:-}" ] && modprobe -q "$MODALIAS" 2>/dev/null
    if [ -n "${INTERFACE:-}" ] && grep -q '^PK_DHCP=yes' /etc/default/pk 2>/dev/null; then
      have() { command -v "$1" >/dev/null 2>&1; }
      have pk-net && pk-net dhcp >/dev/null 2>&1
    fi
    ;;
esac
exit 0
HOOK
chmod 755 /etc/mdev/hotplug.sh 2>/dev/null

if [ ! -f /etc/mdev.conf ]; then
  cat > /etc/mdev.conf <<'CONF'
# busybox mdev: /dev nodes + add-action hook (@)
console        0:5      600
fb0            0:44     660
input/.*       0:0      600
tty[0-9]*      0:5      666
.*             0:0      666   @/etc/mdev/hotplug.sh
CONF
fi

say "coldplug: /dev scan (mdev -s)"
busybox mdev -s >/dev/null 2>&1
rc=$?

lis=0
if [ -x /bin/uevent ] || have uevent; then
  ( setsid busybox uevent busybox mdev >/dev/null 2>&1 & ) 2>/dev/null && lis=1
fi
# purana interface agar maujood ho to wo bhi bhar dete hain (harmless bonus)
if [ -e /proc/sys/kernel/hotplug ]; then
  printf '/bin/mdev\n' > /proc/sys/kernel/hotplug 2>/dev/null || true
fi

if [ "$lis" = 1 ]; then
  say "mdev ready (uevent listener on, coldplug rc=$rc)"
  mark "MDEV-OK (uevent listener + coldplug, rc=$rc)"
else
  say "mdev ready (sirf coldplug - uevent applet nahi mila)"
  mark "MDEV-COLDPLUG (rc=$rc)"
fi
exit 0
