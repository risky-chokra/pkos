#!/bin/sh
# pk's OS :: app runtime ka shell (Debian userland ke andar)
#   pk-shell            -> /opt/pk me root shell
#   pk-shell -c "cmd"   -> wahi command wahan chalao
# Exit karte hi binds nahi hatte (apps ko chahiye ho sakte hain); 'pk-shell --clean' se hatao.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
if [ "${1:-}" = --clean ]; then exec pk-chroot --umount; fi
[ -t 0 ] || { exec pk-chroot "$@"; }
echo "pk's OS runtime shell - '(exit)' se bahar.  pkgs: apt-get, dpkg  |  apps: pk-run --list"
echo "release: $(cat /opt/pk/etc/pk-runtime-release 2>/dev/null || echo '(runtime me koi release file nahi)')"
exec pk-chroot /bin/sh
