#!/bin/sh
# pk's OS :: ek command me poora health + hardware check
#   pk-check              boot, net, runtime, apps, disk, USB, display, KVM, Secure Boot...
#   pk-check --verbose    har check ka detail
#   pk-check --save       report /run/pk/check.txt (+ /tmp/pk-check.txt) me likho
#   pk-check --apps       app battery bhi chala do (pk-run --selftest)
#   pk-check --gui        Xvfb/weston utha ke ek X client se display test karo
#   pk-check --speed      disk write speed (pendrive pe khaali jagah me 64 MB)
#
# Real PC / pendrive test ke liye bana: sab kuch PASS dikhaye to image + hardware
# dono theek hain. Kuch FAIL ho to `pk-check --save` ki file hi bhej dena.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
VERB=0 SAVE=0 DOAPPS=0 DOGUI=0 DOSPEED=0
for a in "$@"; do
  case "$a" in
    --verbose|-v) VERB=1 ;;
    --save)       SAVE=1 ;;
    --apps)       DOAPPS=1 ;;
    --gui)        DOGUI=1 ;;
    --speed)      DOSPEED=1 ;;
    --all)        VERB=1; SAVE=1; DOAPPS=1; DOGUI=1; DOSPEED=1 ;;
    --help|-h)    sed -n '2,12p' "$0"; exit 0 ;;
  esac
done

RT=${PK_RUNTIME_ROOT:-/opt/pk}
pass_n=0; fail_n=0; warn_n=0; info_n=0
REP=/run/pk/check.txt
ROWS=/run/pk/check.rows
mkdir -p /run/pk 2>/dev/null
: > "$ROWS" 2>/dev/null

row() { # <ok|fail|warn|info> <name> <detail>
  st=$1; name=$2; det=${3:-}
  case "$st" in
    ok)   pass_n=$((pass_n + 1)); p='[ok  ]' ;;
    fail) fail_n=$((fail_n + 1)); p='[FAIL]' ;;
    warn) warn_n=$((warn_n + 1)); p='[warn]' ;;
    *)    info_n=$((info_n + 1)); p='[info]' ;;
  esac
  line=$(printf '%-6s %-13s %s' "$p" "$name" "$det")
  printf '%s\n' "$line"
  printf '%s\n' "$line" >> "$ROWS" 2>/dev/null
}

have() { command -v "$1" >/dev/null 2>&1; }
mounted() { grep -q " $1 " /proc/mounts 2>/dev/null; }

# ------------------------------------------------------------------ system
row info system "$(uname -s) $(uname -r) $(uname -m) | $(cat /etc/os-release 2>/dev/null | sed -n 's/^PRETTY_NAME=//p' | tr -d '"')"

mode=$(sed -n 's/^\(.*\) mode=\(live\|installed\|toram\).*/\2/p' /run/pk/boot.env 2>/dev/null | head -1)
[ -n "$mode" ] || mode=$(awk -F'mode=' '/PK_BOOT_MODE/{print $2}' /run/pk/boot.env 2>/dev/null | head -1)
[ -n "$mode" ] || mode=$(grep -o 'mode=[a-z]*' /run/pk/boot.env 2>/dev/null | head -1 | cut -d= -f2)
[ -n "$mode" ] || mode='(unknown)'
row ok boot "mode=$mode"
if [ -r /run/pk/boot.env ]; then row ok bootenv "$(tr '\n' ' ' < /run/pk/boot.env | cut -c1-120)"; else row warn bootenv "/run/pk/boot.env nahi mila (pk-boot chala?)"; fi

# root writable? (overlay upper)
if touch /run/pk/.wtest 2>/dev/null; then rm -f /run/pk/.wtest; row ok writable "/ writable hai"; else row fail writable "/ read-only hai"; fi
up=$(awk '$2=="/"{print $4}' /proc/mounts 2>/dev/null | head -1)
case "$up" in
  *upperdir=/mnt/persist*) row ok persist "upper=/mnt/persist (USB pe save hota hai)" ;;
  *upperdir=*)             row info persist "upper=RAM (reboot pe reset) - 'persistent' boot option use karo" ;;
  ext4|ext2)               row ok persist "installed ext4 root (changes save)" ;;
  *)                       row info persist "root fs: ${up:-?}" ;;
esac

# ------------------------------------------------------------------ hardware
cpu=$(sed -n 's/^model name[ ]*:[ ]*//p' /proc/cpuinfo 2>/dev/null | head -1)
row info cpu "${cpu:-x86_64} ($(grep -c ^processor /proc/cpuinfo 2>/dev/null || echo ?) threads)"
memtot=$(awk '/MemTotal/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
memavl=$(awk '/MemAvailable/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
row info mem "${memtot:-?} MB total / ${memavl:-?} MB free"
if [ -e /dev/kvm ]; then row ok kvm "/dev/kvm (QEMU hardware accel chalega)"; else row info kvm "/dev/kvm nahi (pk-vm TCG se chalega, dheema)"; fi

# USB speed of the boot device (pendrive test ka main point)
spd=''
if [ -d /sys/bus/usb/devices ]; then
  for d in /sys/bus/usb/devices/*/speed; do
    [ -r "$d" ] || continue
    v=$(cat "$d" 2>/dev/null)
    [ -n "$v" ] && spd="$spd $(printf '%s' "$(basename "$(dirname "$d")")")=$v"
  done
fi
if [ -n "$spd" ]; then
  case " $spd " in
    *" 5000000000 "*|*" 10000000000 "*|*" 20000000000 "*) row ok usb "super speed (USB3):$spd" ;;
    *" 480000000 "*)                                         row ok usb "high speed (USB2):$spd" ;;
    *" 12000000 "*)                                          row warn usb "full speed (USB1, 12 Mb) - boot/USB apps bahut dheeme: $spd" ;;
    *)                                                        row info usb "usb devices:$spd" ;;
  esac
else
  row info usb "koi USB device speed file nahi (toram? ya USB boot nahi)"
fi

# disks
disks=''
for d in /sys/block/*; do
  n=${d##*/}
  case "$n" in loop*|ram*|zram*) continue ;; esac
  szb=$(cat "$d/size" 2>/dev/null || echo 0)
  gb=$(( szb / 2048 / 512 ))
  ro=''
  [ -w "/dev/$n" ] || ro=' (ro)'
  disks="$disks $n=${gb}G$ro"
done
row info disks "${disks:- koi block dev nahi}"
if [ "$DOSPEED" = 1 ]; then
  t=/var/tmp/pk-speed.$$
  s=$( ( dd if=/dev/zero of="$t" bs=1M count=64 conv=fsync 2>&1 | tail -1 ) 2>/dev/null )
  rm -f "$t" 2>/dev/null
  rate=$(printf '%s' "$s" | sed -n 's/.* \([0-9.]*\) [MG]B.s.*/\1/p' | head -1)
  unit=$(printf '%s' "$s" | sed -n 's/.*[0-9.]* \([MG]\)B.s.*/\1/p' | head -1)
  if [ -n "$rate" ]; then row ok speed "write ${rate} ${unit}B/s (fsync, 64 MB)"; else row warn speed "speed test fail (fs read-only?)"; fi
fi

# ------------------------------------------------------------------ display
if [ -e /dev/fb0 ]; then row ok fb "/dev/fb0 (framebuffer)"; else row info fb "/dev/fb0 nahi (GUI ke liye DRM/Xvfb use hoga)"; fi
drm=''
for c in /dev/dri/card*; do [ -e "$c" ] && drm="$drm $c"; done
for c in /dev/dri/renderD128*; do [ -e "$c" ] && drm="$drm $c"; done
if [ -n "$drm" ]; then row ok drm "KMS devices:$drm (weston KMS backend chalega)"; else row info drm "/dev/dri nahi (weston ko headless/Xvfb chahiye)"; fi
if [ "$DOGUI" = 1 ]; then
  if [ -x /usr/bin/pk-x ]; then
    pk-x start > /run/pk/gui-start.log 2>&1
    rc=$?
    [ -r /run/pk/x-env ] && . /run/pk/x-env
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
      row ok display "pk-x start ok: DISPLAY=${DISPLAY:-none} WAYLAND=${WAYLAND_DISPLAY:-none} (rc=$rc)"
      if [ -x "$RT/usr/bin/xdpyinfo" ] && [ -n "${DISPLAY:-}" ]; then
        out=$(pk-run --gui xdpyinfo 2>&1 | sed -n '2p' | tr '\n' ' ' | cut -c1-70)
        if [ -n "$out" ]; then row ok xclient "xdpyinfo: $out"; else row fail xclient "X client connect nahi hua"; fi
      fi
      if [ -x "$RT/usr/bin/xterm" ]; then
        if pk-run --gui xterm -e /bin/sh -c 'echo GUI-APP-OK > /tmp/gui-app.txt' >/dev/null 2>&1; then
          row ok xterm "xterm -e 'echo' chala (X client round-trip)"
        else
          row warn xterm "xterm rc!=0 (detail: cat /run/pk/x.log)"
        fi
      fi
      [ "$VERB" = 1 ] && { echo '  -- pk-x log --'; tail -6 /run/pk/x.log 2>/dev/null | sed 's/^/  /'; }
    else
      row fail display "pk-x start fail (rc=$rc) -- runtime me weston/Xvfb hai?  pk-get install -y weston xvfb x11-utils"
      tail -4 /run/pk/gui-start.log 2>/dev/null | sed 's/^/       /'
    fi
  else
    row warn display "/usr/bin/pk-x nahi (image purani?)"
  fi
fi

# ------------------------------------------------------------------ network
ip=$(ip -4 addr show 2>/dev/null | awk '/inet /{if($2!~/^127\./){print $2; exit}}')
gw=$(ip route 2>/dev/null | awk '/default/{print $3; exit}')
if [ -n "$ip" ]; then
  row ok net "IP=$ip gw=${gw:-none}"
  if [ -n "$gw" ]; then
    if ping -c1 -W2 "$gw" >/dev/null 2>&1; then row ok ping "gateway reachable"; else row warn ping "gateway ping nahi gaya"; fi
  fi
  dns=$(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf 2>/dev/null)
  if [ -n "$dns" ]; then
    row info dns "resolver=$dns"
    if ping -c1 -W3 "$dns" >/dev/null 2>&1; then row ok dns "$dns reachable (real resolve ke liye: wget -qO- http://deb.debian.org/ )"; else row warn dns "$dns ping nahi gaya (user-net gw DNS block karta hai)"; fi
  else
    row warn dns "/etc/resolv.conf me nameserver nahi"
  fi
else
  row warn net "koi IP nahi - 'pk-net dhcp' chalao (boot option pk_net=dhcp)"
fi
if [ -d /sys/class/net ]; then
  for n in /sys/class/net/*; do
    st=$(cat "$n/operstate" 2>/dev/null)
    [ "$st" = up ] && row info iface "${n##*/}=up"
  done
fi
# wifi
wdev=''
for w in /sys/class/net/*; do
  case "$w" in */wireless|*/phy80211*) : ;; *) continue ;; esac
  wdev="$wdev ${w##*/}"
done
fw=''
for f in /lib/firmware /vendor_fw; do
  [ -d "$f" ] && fw="$fw $f:$(ls "$f" 2>/dev/null | wc -l)"
done
if [ -n "$wdev" ]; then row ok wifi "wireless iface:$wdev (connect: wpa_supplicant nahi hai -> docs/APPS.md)"; else row info wifi "wireless iface nahi dikha; firmware:${fw:- none} (ISO me PK_FIRMWARE=1 se drivers aaate hain)"; fi
if [ -x /sbin/pk-ssh ]; then
  if pgrep dropbear >/dev/null 2>&1; then row ok ssh "dropbear :22 chal raha hai"; else row info ssh "dropbear band (pk-ssh start)"; fi
fi

# ------------------------------------------------------------------ runtime + apps
if mounted "$RT" && [ -d "$RT/usr" ]; then
  rel=$(cat "$RT/etc/pk-runtime-release" 2>/dev/null | head -1)
  row ok runtime "$RT attached (${rel:- no release file})"
  [ -x "$RT/usr/bin/apt-get" ] && row ok apt "runtime me apt-get hai -> pk-get install -y <pkg>" || row warn apt "runtime me apt-get nahi (tiny/QA runtime?)"
  [ -x "$RT/usr/bin/dpkg" ] && row info dpkg "dpkg hai (.deb install direct hoga)"
  if [ -x "$RT/usr/bin/wine" ] || [ -e "$RT/usr/bin/wine" ] || [ -L "$RT/usr/bin/wine" ]; then
    wv=$(pk-chroot /usr/bin/wine --version 2>/dev/null | head -1)
    row ok wine "wine: ${wv:-present}"
  else
    row info wine "wine nahi -> Windows apps ke liye: pk-get install -y wine"
  fi
  n=$(ls "$RT/var/lib/dpkg/info" 2>/dev/null | grep -c '\.list$')
  row info pkgcount "installed pkgs in runtime: ${n:-0}"
  m=$(ls -1 "$RT/apps/bin" 2>/dev/null | wc -l)
  row info appcount "pk apps: ${m:-0}"
else
  row info runtime "app runtime nahi laga (pk-runtime status) - base OS me bhi static/busybox apps chalti hain"
fi
if [ "$DOAPPS" = 1 ] && [ -x /sbin/pk-run ]; then
  out=$(pk-run --selftest 2>&1 | tr '\n' '|' | cut -c1-140)
  row ok appbattery "pk-run --selftest: ${out:-(<output console/kmsg par>)}"
fi

# ------------------------------------------------------------------ iOS / Android
if [ -x /sbin/pk-ios ]; then
  out=$(pk-ios doctor 2>&1 | tr '\n' ';' | cut -c1-150)
  row info ios "$out"
fi
if [ -x /sbin/pk-android ]; then
  out=$(pk-android doctor 2>&1 | tr '\n' ';' | cut -c1-150)
  row info android "$out"
fi

# ------------------------------------------------------------------ input + clock + secure boot
row info kbd "$(ls /sys/class/input 2>/dev/null | grep -c 'event') input event devices; keymap: $(cat /run/pk/keymap 2>/dev/null || echo us)"
rtc=$(hwclock -r 2>/dev/null | head -1)
if [ -n "$rtc" ]; then row ok clock "RTC: $rtc"; else row warn clock "hwclock padha nahi ja paya (battery/CMOS check)"; fi
sb=$(od -An -tx1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | tr -d ' ')
if [ -n "$sb" ]; then
  case "$sb" in
    01) row warn secureboot "SecureBoot ON hai - unsigned GRUB boot nahi karega; BIOS me OFF karo (ya MOK enroll)" ;;
    00) row ok secureboot "SecureBoot OFF ✓ (hamara signed-naahi GRUB chalega)" ;;
    *)  row info secureboot "SecureBoot var value=$sb" ;;
  esac
else
  if [ -d /sys/firmware/efi ]; then row info secureboot "efi vars me SecureBoot nahi mila (CSM? ya var padhne se block)"; else row info secureboot "BIOS/Legacy boot (SecureBoot lagu nahi)"; fi
fi
if dmesg 2>/dev/null | grep -qiE "error|fail"; then
  n=$(dmesg 2>/dev/null | grep -ciE "error|fail")
  row warn dmesg "$n error/fail lines (verbose me dekho: dmesg | grep -iE 'error|fail')"
  [ "$VERB" = 1 ] && dmesg 2>/dev/null | grep -iE "error|fail" | tail -8 | sed 's/^/       /'
else
  row ok dmesg "koi error/fail line nahi"
fi

# ------------------------------------------------------------------ summary
sum=$(printf 'CHECK-SUMMARY ok=%s fail=%s warn=%s info=%s' "$pass_n" "$fail_n" "$warn_n" "$info_n")
echo
printf '%s\n' "----------------------------------------------------------------"
printf '%s\n' "  $sum"
printf '%s\n' "----------------------------------------------------------------"
if [ "$fail_n" = 0 ]; then
  ( printf '### PK: %s ###\n' "$sum" > /dev/console ) 2>/dev/null
  ( printf '### PK: CHECK-OK (%s checks, 0 fail) ###\n' "$pass_n" > /dev/console ) 2>/dev/null
  ( printf '### PK: CHECK-OK ###\n' > /dev/kmsg ) 2>/dev/null
else
  ( printf '### PK: %s ###\n' "$sum" > /dev/console ) 2>/dev/null
  ( printf '### PK: CHECK-FAIL(%s) ###\n' "$fail_n" > /dev/console ) 2>/dev/null
  ( printf '### PK: CHECK-FAIL(%s) ###\n' "$fail_n" > /dev/kmsg ) 2>/dev/null
fi
if [ "$SAVE" = 1 ]; then
  {
    printf 'pk-check report %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo '?')"
    cat "$ROWS" 2>/dev/null
    printf '\n%s\n' "$sum"
  } > "$REP" 2>/dev/null
  cp -f "$REP" /tmp/pk-check.txt 2>/dev/null
  printf '%s\n' "report: $REP (+ /tmp/pk-check.txt)"
fi
[ "$fail_n" = 0 ] && exit 0
exit 1
